Q4 : Write a program to solve the 4-Puzzle Problem using the A* Search Algorithm. A 4-Puzzle consists of 4 tiles and one blank space arranged in a 2 × 2 grid. 

import heapq  
start = (1, 0, 3, 2) 
goal = (1, 2, 3, 0)  
def heuristic(state):    
distance = 0     
for i in range(4):     
if state[i] == 0:        
continue         
row1 = i // 2     
col1 = i % 2         
goal_index = goal.index(state[i])  
row2 = goal_index // 2        
col2 = goal_index % 2        
distance += abs(row1 - row2) + abs(col1 - col2)  
return distance  
def get_neighbors(state):    
neighbors = [] 
blank = state.index(0)   
row = blank // 2    
col = blank % 2   
moves = [       
(-1, 0),   
(1, 0),    
(0, -1),   
(0, 1)    
]    
for dr, dc in moves:   
new_row = row + dr        
new_col = col + dc         
if 0 <= new_row < 2 and 0 <= new_col < 2:  
new_blank = new_row * 2 + new_col          
new_state = list(state)          
new_state[blank], new_state[new_blank] = new_state[new_blank], new_state[blank]       
neighbors.append(tuple(new_state))  
return neighbors 
def a_star(start, goal):      
queue: (f, g, state, path)  
open_list = []  
heapq.heappush( 
open_list,     
(heuristic(start), 0, start, [start])    
)     
visited = set() 
while open_list:      
f, g, current, path = heapq.heappop(open_list)     
if current in visited:         
continue   
visited.add(current)        
if current == goal:     
return path       
for neighbor in get_neighbors(current):  
if neighbor not in visited:        
new_g = g + 1       
new_f = new_g + heuristic(neighbor)        
heapq.heappush(                
open_list,           
(new_f, new_g, neighbor, path + [neighbor])    
)      
return None 
