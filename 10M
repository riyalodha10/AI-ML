   Q11 : Write the program to implement the AO* Algorithm 

graph = {   
'A': {  
'type': 'OR',     
'children': [('B', 2), ('C', 3)]  
},  
'B': {        
'type': 'AND',     
'children': [('D', 1), ('E', 4)]   
}, 
'C': {  
'type': 'OR',     
'children': [('F', 2), ('G', 5)]   
},   
'D': {  
'type': 'OR',   
'children': [('H', 2), ('I', 3)]     
},   
'E': {
'type': 'OR',      
'children': [('J', 1)]  
},   
'F': {'type': 'GOAL', 'children': []},    
'G': {'type': 'GOAL', 'children': []},   
'H': {'type': 'GOAL', 'children': []},  
'I': {'type': 'GOAL', 'children': []},   
'J': {'type': 'GOAL', 'children': []} 
}   def ao_star(node):    
if graph[node]['type'] == 'GOAL':        
return 0, [node]     
children = graph[node]['children']  
if graph[node]['type'] == 'OR':         
best_cost = float('inf')     
best_path = None       
for child, edge_cost in children:       
child_cost, child_path = ao_star(child)  
total_cost = edge_cost + child_cost         
if total_cost < best_cost:          
best_cost = total_cost          
best_path = [node] + child_path     
return best_cost, best_path    
elif graph[node]['type'] == 'AND':   
total_cost = 0     
path = [node]   
for child, edge_cost in children: 
child_cost, child_path = ao_star(child)    
total_cost += edge_cost + child_cost       
path += child_path     
return total_cost, path  
cost, solution = ao_star('A')
print("AO* Solution:")
print(" -> ".join(solution)) 
print("Total Cost:", cost) 




Q3: Write a program to demonstrate the Hill Climbing Algorithm for finding the maximum value of a simple objective function.

def f(x): 
return -x**2 + 4*x 
def hill_climbing(start, step=1):  
current = start    
while True:     
current_value = f(current)          
left = current - step     
right = current + step          
if f(left) > current_value:      
current = left   
elif f(right) > current_value:  
current = right       
else:
break   
return current, f(current)   start = 0  
