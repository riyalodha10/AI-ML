Q2. Alpha-Beta Pruning


def alpha_beta(node, depth, alpha, beta, maximizing_player):
    if isinstance(node, int):
        return node
    if maximizing_player:
        value = float('-inf')
        for i, child in enumerate(node):
            value = max(
                value,
                alpha_beta(child, depth + 1, alpha, beta, False)
            )
            alpha = max(alpha, value)
            if alpha >= beta:
                print("Pruned branch at MAX node")
                break
        return value
    else:
        value = float('inf')
        for i, child in enumerate(node):
            value = min(
                value,
                alpha_beta(child, depth + 1, alpha, beta, True)
            )
            beta = min(beta, value)            
            if alpha >= beta:
                print("Pruned branch at MIN node")
                break
        return value
game_tree = [
    [3, 5], # A
    [2, 9], # B
    [0, 7] # C
]
best_value = alpha_beta(
    game_tree,
    0,
    float('-inf'),
    float('inf'),
    True
)
print("\nBest value using Alpha-Beta Pruning:", best_value)




