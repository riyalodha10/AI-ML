Q4. Minimax Algorithm


def minimax(node, maximizing_player):
    if isinstance(node, int):
        return node
    if maximizing_player:
        best_value = float('-inf')
        for child in node:
            value = minimax(child, False)
            best_value = max(best_value, value)
        return best_value
    else:
        best_value = float('inf')
        for child in node:
            value = minimax(child, True)
            best_value = min(best_value, value)
        return best_value
game_tree = [
    [3, 5],
    [2, 9]
]
optimal_value = minimax(game_tree, True)
print("Game Tree:")
print(" A (MAX)")
print(" / \\")
print(" B (MIN) C (MIN)")
print(" / \\ / \\")
print(" 3 5 2 9")
print("\nMinimax Evaluation:")
print("B = MIN(3, 5) =", min(3, 5))
print("C = MIN(2, 9) =", min(2, 9))
print("A = MAX(3, 2) =", max(3, 2))
print("\nOptimal value selected by Minimax:", optimal_value)



