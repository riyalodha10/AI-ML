Q1:  Write a program to solve the Map Coloring Problem using the Constraint Satisfaction Problem (CSP) approach.               


variables = ['A', 'B', 'C', 'D']
colors = ['Red', 'Green', 'Blue']
neighbors = {
    'A': ['B', 'C'],
    'B': ['A', 'D'],
    'C': ['A', 'D'],
    'D': ['B', 'C']
}
def is_valid(region, color, a):
    for neighbour in neighbors[region]:
        if neighbour in a:
            if a[neighbour] == color:
                return False
    return True
def solve(a):
    if len(a) == len(variables):
        return a
        
    for region in variables:
        if region not in a:
            for color in colors:
                if is_valid(region, color, a):
                    a[region] = color
                    result = solve(a)
                    if result:
                        return result
                    del a[region]
            return None
solution = solve({})
if solution:
    print("Map Coloring Solution:")
    for region in variables:
        print(region, "->", solution[region])
else:
    print("No solution exists")





2) CSP-Constraint Satisfaction Problem


vertices = [1, 2, 3, 4, 5]
colors = ['Red', 'Green', 'Blue', 'Yellow', 'Orange']
graph = {
    1: [2, 3, 4, 5],
    2: [1, 3, 4, 5],
    3: [1, 2, 4, 5],
    4: [1, 2, 3, 5],
    5: [1, 2, 3, 4]
}
def safe(vertex, color, a):
    for neighbour in graph[vertex]:
        if neighbour in a and a[neighbour] == color:
            return False
    return True
def solve(a):
    if len(a) == len(vertices):
        return True
    for vertex in vertices:
        if vertex not in a:
            for color in colors:
                if safe(vertex, color, a):
                    a[vertex] = color
                    if solve(a):
                        return True
                    del a[vertex]
            return False
a = {}
if solve(a):
    print("Solution:")
    for vertex in vertices:
        print("Vertex", vertex, "->", a[vertex])
else:
    print("No solution exists.")




